# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/easyapply

# S3 Document Storage (optional — KYC review images are served as pre-signed
# S3 URLs when configured, otherwise the local /uploads fallback is used)
S3_BUCKET=
S3_FOLDER=documents
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_access_secret_key_change_me_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_me_in_production

# JWT Expiry Settings
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# PayHere Sandbox Credentials
PAYHERE_MERCHANT_ID=1237114
PAYHERE_MERCHANT_SECRET=MTA0ODE1MjY4MDQyNDI4MjAwNTUxNTU5NDAwOTUwMjg2MTUwMzA4Mg==

# Frontend URL for CORS
# Local development: http://localhost:5173
# Production: https://easyapply.sltmobitel.lk
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# SMTP / Nodemailer — Payment Confirmation Email
# ─────────────────────────────────────────────
# Leave SMTP_HOST blank to run in DEMO mode (Ethereal Email — no real emails sent).
# A preview URL will be logged to the console after every successful payment.
#
# For real delivery, fill in your SMTP provider credentials:
#   Gmail:    SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   SendGrid: SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SLTMobitel EasyApply <noreply@sltmobitel.lk>"
