# Server Configuration
PORT=5050
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/paperlessoutlet

# GridFS Bucket — uploaded KYC documents (NICs, passports, signatures, BRC)
# are stored inside MongoDB under this GridFS bucket name.
GRIDFS_BUCKET=uploads

# S3 Document Storage (optional)
S3_BUCKET=
S3_FOLDER=documents
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_access_secret_key_change_me_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_me_in_production

# JWT Expiry Settings
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# PayHere Sandbox Credentials
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=1237114
PAYHERE_MERCHANT_SECRET=YOUR_PAYHERE_MERCHANT_SECRET

# PayHere Callback URLs
PAYHERE_NOTIFY_URL=https://your-public-url.com/api/payments/notify
PAYHERE_RETURN_URL=http://localhost:5173/payment/success
PAYHERE_CANCEL_URL=http://localhost:5173/payment/cancel

# OpenAI Router
OPENAI_ROUTER_TOKEN=YOUR_OPENAI_ROUTER_TOKEN

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# SLT Hosted Product Hub Configuration
PRODUCT_HUB_AUTH_URL=https://dpdlab1.slt.lk:703/api/users/login
PRODUCT_HUB_EMAIL=user@slt.com
PRODUCT_HUB_PASSWORD=YOUR_PRODUCT_HUB_PASSWORD

# 1. All Products List Endpoint
PRODUCT_HUB_URL=https://dpdlab1.slt.lk:703/public-api/v1/products

# 2. Left Sidebar Tree (Hierarchy / Filter) Endpoint
PRODUCT_HUB_HIERARCHY_URL=https://dpdlab1.slt.lk:703/public-api/v1/products/hierarchy

# 3. Product Cart Endpoint (Item by ID)
PRODUCT_HUB_CART_URL=https://dpdlab1.slt.lk:703/public-api/v1/products

# 4. View Details Endpoint (Full Product Specifications)
PRODUCT_HUB_DETAILS_URL=https://dpdlab1.slt.lk:703/public-api/v1/integration/products

# ─────────────────────────────────────────────────────────────
# SMTP — Email OTP Delivery (Live SMTP Server)
# ─────────────────────────────────────────────────────────────
# Set SMTP_HOST and SMTP_USER to enable live email delivery.
# SMTP_PASS: leave empty or set to "N/A" for relay/no-auth mode
#   (internal SLT corporate relay accepts unauthenticated send).
#   If SMTP_PASS has a real value, it will be used for authentication.
# SMTP_SECURE: set to "true" for direct SSL/TLS (port 465), "false" for STARTTLS.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=something.slt.com.lk
SMTP_PORT=44
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASS=
SMTP_FROM="SLTMobitel EasyApply" <no-reply@slt.lk>
