
# =============================================
# Server Configuration
# =============================================
PORT=5050
NODE_ENV=development

# =============================================
# Database Configuration (PostgreSQL / Supabase / Company DB)
# =============================================
# Standard PostgreSQL connection URL
# Supabase example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Local/Company example: postgresql://postgres:password@localhost:5432/paperlessoutlet
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/paperlessoutlet
DATABASE_SSL=false

# Legacy MongoDB (kept for one-time ETL migration script)
MONGO_URI=mongodb://127.0.0.1:27017/paperlessoutlet

# =============================================
# Centralized Object Storage (Supabase Storage / AWS S3 / MinIO)
# =============================================
# Supabase S3 endpoint: https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_ENDPOINT=
STORAGE_BUCKET=kyc-documents
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# =============================================
# JWT Authentication Secrets
# =============================================
JWT_ACCESS_SECRET=your_access_secret_key_change_me_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_me_in_production

# JWT Expiry Settings
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# =============================================
# PayHere Sandbox Credentials
# =============================================
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=1237114
PAYHERE_MERCHANT_SECRET=YOUR_PAYHERE_MERCHANT_SECRET

# PayHere Callback URLs
PAYHERE_NOTIFY_URL=https://your-public-url.com/api/payments/notify
PAYHERE_RETURN_URL=http://localhost:5173/payment/success
PAYHERE_CANCEL_URL=http://localhost:5173/payment/cancel

# =============================================
# OpenAI Router
# =============================================
OPENAI_ROUTER_TOKEN=YOUR_OPENAI_ROUTER_TOKEN

# =============================================
# Frontend URL for CORS
# =============================================
FRONTEND_URL=http://localhost:5173

# =============================================
# SLT Hosted Product Hub Configuration
# =============================================
PRODUCT_HUB_AUTH_URL=https://dpdlab1.slt.lk:703/api/users/login
PRODUCT_HUB_EMAIL=user@slt.com
PRODUCT_HUB_PASSWORD=YOUR_PRODUCT_HUB_PASSWORD

# 1. All Products List Endpoint
PRODUCT_HUB_URL=https://dpdlab1.slt.lk:703/public-api/v1/products

# 2. Left Sidebar Tree (Hierarchy / Filter)
PRODUCT_HUB_HIERARCHY_URL=https://dpdlab1.slt.lk:703/public-api/v1/products/hierarchy

# 3. Product Cart Endpoint (Item by ID)
PRODUCT_HUB_CART_URL=https://dpdlab1.slt.lk:703/public-api/v1/products

# 4. View Details Endpoint (Full Specifications)
PRODUCT_HUB_DETAILS_URL=https://dpdlab1.slt.lk:703/public-api/v1/integration/products

# =============================================
# Package Selection Portal
# =============================================
# Portal where customers select LTE/FTTH packages
PACKAGE_SELECTION_PORTAL_URL=https://dpdlab1.slt.lk:703

# =============================================
# Gemini API Configuration
# =============================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# NIC OCR engine:
#   auto   = Gemini first, local PaddleOCR model if Gemini fails (default)
#   local  = local model only; nothing is sent to Gemini
#   gemini = Gemini only
NIC_OCR_ENGINE=auto

# =============================================
# SMTP — Email OTP Delivery
# =============================================
# Set SMTP_HOST and SMTP_USER to enable
# live email delivery.
#
# SMTP_PASS:
# Leave empty or set to "N/A" for relay/no-auth
# mode if the SMTP server supports it.
#
# SMTP_SECURE:
# true  = direct SSL/TLS (typically port 465)
# false = STARTTLS (typically port 587)
# =============================================

SMTP_HOST=something.slt.com.lk
SMTP_PORT=44
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASS=
SMTP_FROM='"SLTMobitel EasyApply" <no-reply@slt.lk>'

# WebAuthn / Passkey Authentication Configuration
WEBAUTHN_RP_NAME="SLTMobitel EasyApply Admin"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Document Security (AES-256-GCM Envelope Encryption at Rest)
DOCUMENT_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# ConsentHub (CMS) integration: Easy Apply consents
CONSENT_HUB_URL=https://dpdlab1.slt.lk:9000
CONSENT_HUB_API_KEY=
# CMS CRM store (the CMS reads customers from here to show their NIC)
CONSENT_HUB_CRM_MONGODB_URI=


# =============================================================================
# Backup & Restore (Backup Dashboard — MANUAL backups only)
# See docs/BACKUP_AND_RESTORE.md
# =============================================================================

# Where backups are kept: "local" (a folder on this server) or "s3"
# (any S3-compatible storage: AWS S3, MinIO, ...). Switching needs no code change.
BACKUP_STORAGE=local

# --- local storage -----------------------------------------------------------
# Folder for backup files. Use a path OUTSIDE the web root and the project
# folder, owned by the service user with mode 700. Created if it does not exist.
BACKUP_LOCAL_PATH=/var/backups/slt-easyapply

# --- s3 storage (only used when BACKUP_STORAGE=s3) -----------------------------
# A dedicated bucket and credentials, separate from the customer-document bucket.
# Leave BACKUP_S3_ENDPOINT empty for AWS S3; set it for MinIO etc.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ap-southeast-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Folder inside the bucket
BACKUP_S3_PREFIX=backups
# true for MinIO and most S3-compatible services
BACKUP_S3_FORCE_PATH_STYLE=true

# --- who may use backups ---------------------------------------------------------
# Comma-separated roles that may use the Backup Dashboard and every backup endpoint.
# Default: Admin. Case and extra spaces are ignored; anyone else gets 403 (also from the API).
# Examples:  BACKUP_ALLOWED_ROLES=Admin   |   BACKUP_ALLOWED_ROLES=Admin,Manager
# In production, restrict access by editing this value and restarting the backend.
# Restore and download still ask for the password again, whoever is allowed.
BACKUP_ALLOWED_ROLES=Admin

# --- encryption (REQUIRED) -----------------------------------------------------
# AES-256-GCM key for every backup file: 32 random bytes as 64 hex characters.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# There is NO fallback key. Keep a copy somewhere safe and separate from the
# backups: without it a backup cannot be restored, and it must never be committed.
BACKUP_ENCRYPTION_KEY=

# --- retention and warnings ----------------------------------------------------
# Maximum number of backups kept. Nothing is ever deleted automatically: at the
# limit, an admin must delete old backups before creating new ones.
BACKUP_MAX_COUNT=30
# Show a warning on the dashboard when the last successful backup is older than this.
BACKUP_WARNING_DAYS=7

# --- database connection for backups (REQUIRED on Supabase) ----------------------
# pg_dump / pg_restore need the DIRECT database connection (normally port 5432), never the
# connection pooler (port 6543, host containing "pooler"). The portal itself may keep using
# the pooled DATABASE_URL. If DATABASE_URL is a pooler address and this is not set,
# backups refuse to start with a clear message. Include ?sslmode=require for Supabase.
# BACKUP_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
# Test restore creates a temporary database and needs the CREATEDB privilege. If the database
# user above cannot have it, point this at a separate PostgreSQL server where it is allowed.
# BACKUP_TEST_RESTORE_URL=postgresql://tester:PASSWORD@scratch-host:5432/postgres

# --- customer documents in the storage bucket (OPTIONAL, OFF by default) -----------
# Adds the Supabase Storage bucket(s) to "Database + uploaded files" backups, read with the
# STORAGE_* credentials above. A restore uploads them back and never deletes other bucket
# files unless the admin ticks a separate option. Must be exactly "true" to turn on.
BACKUP_INCLUDE_SUPABASE_STORAGE=false
# Comma-separated bucket names; defaults to STORAGE_BUCKET.
# BACKUP_SUPABASE_BUCKETS=kyc-documents

# --- single backend instance ----------------------------------------------------------
# Backups keep their job lock, restore maintenance mode and download links in process memory,
# so the backend must run as ONE instance (PM2 fork mode, instances: 1 — see ecosystem.config.cjs).
# With several instances backups are refused. Override only if you know what you are doing:
# BACKUP_ALLOW_MULTI_INSTANCE=false

# --- tools and tuning (optional) -----------------------------------------------
# PostgreSQL client tools (version should match the database server).
# Only needed when they are not on the PATH.
# PG_DUMP_PATH=/usr/lib/postgresql/16/bin/pg_dump
# PG_RESTORE_PATH=/usr/lib/postgresql/16/bin/pg_restore
# Working folder for temporary (decrypted) files; needs free space of about 2x the database size.
# BACKUP_TMP_DIR=/var/tmp/slt-backup
# Folder archived by the "Database + uploaded files" option.
# BACKUP_UPLOADS_PATH=./uploads
# Run dump/archive at low CPU priority (nice) on Linux so the live portal is not slowed. Default true.
BACKUP_LOW_PRIORITY=true
# Seconds a download link stays valid (single use). Default 60.
BACKUP_DOWNLOAD_TTL_SEC=60
# Database used for CREATE/DROP DATABASE during "Test restore". Default postgres.
# The database user needs the CREATEDB privilege for test restores.
# BACKUP_ADMIN_DATABASE=postgres

# Behind nginx / a load balancer, set to 1 so audit logs record the real client IP address.
# TRUST_PROXY=1
