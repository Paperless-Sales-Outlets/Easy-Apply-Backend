# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/easyapply

# GridFS Bucket — uploaded KYC documents (NICs, passports, signatures, BRC)
# are stored inside MongoDB under this GridFS bucket name.
# You can inspect them in MongoDB Compass under: <db>.uploads.files / .chunks
GRIDFS_BUCKET=uploads

# S3 Document Storage (optional — KYC review images are served as pre-signed
# S3 URLs when configured, otherwise the local /uploads fallback is used)
S3_BUCKET=
S3_FOLDER=documents
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_access_secret_key_change_me_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_me_in_production

# JWT Expiry Settings
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# PayHere Sandbox Credentials
PAYHERE_MERCHANT_ID=1237114
PAYHERE_MERCHANT_SECRET=MTA0ODE1MjY4MDQyNDI4MjAwNTUxNTU5NDAwOTUwMjg2MTUwMzA4Mg==

# Frontend URL for CORS
# Local development: http://localhost:5173
# Production: https://easyapply.sltmobitel.lk
FRONTEND_URL=http://localhost:5173

